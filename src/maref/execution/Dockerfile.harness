FROM python:3.12-slim

LABEL org.opencontainers.image.title="MAREF Harness Service"
LABEL org.opencontainers.image.description="Harness execution service with FastAPI"
LABEL org.opencontainers.image.version="0.1.0"

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src/ src/

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e ".[all]" && \
    pip install --no-cache-dir fastapi uvicorn

RUN addgroup --system --gid 1001 maref && \
    adduser --system --uid 1001 --gid 1001 maref

RUN mkdir -p /app/data /app/logs && chown -R maref:maref /app

USER maref

ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "from urllib.request import urlopen; urlopen('http://localhost:8000/harness/health')" || exit 1

ENTRYPOINT ["python", "-m", "maref.execution.server"]

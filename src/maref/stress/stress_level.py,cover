>     @property
>     def numeric(self) -> int:
>         return self.value[0]
  
>     @property
>     def label(self) -> str:
>         return self.value[1]
  
>     @property
>     def description(self) -> str:
>         return self.value[2]
  
>     @classmethod
>     def from_numeric(cls, n: int) -> StressLevel:
>         for level in cls:
>             if level.numeric == n:
>                 return level
>         return cls.L3
  
  

!         GovernanceState.STABILIZE: {"cooldown_seconds": 30, "observation_window": 60},
!         GovernanceState.REPORT: {"include_audit_trail": True, "format": "jsonl"},
!         GovernanceState.HALT: {"reason_required": True, "terminal": True},
!     }
  

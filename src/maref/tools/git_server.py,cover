! class RepoWhitelist:
!     def __init__(self, allowed_paths: list[str] | None = None) -> None:
!         self._allowed: list[str] = [str(Path(p).resolve()) for p in (allowed_paths or [])]
  
!     def is_allowed(self, path: str) -> bool:
!         resolved = str(Path(path).resolve())
!         return resolved in self._allowed
  
!     @property
!     def allowed_paths(self) -> list[str]:
!         return list(self._allowed)
  
  
! def _is_git_repo(path: str) -> bool:
!     return (Path(path) / ".git").is_dir()
  
  
! def _validate_repo_access(path: str, whitelist: RepoWhitelist) -> None:
!     if not whitelist.is_allowed(path):
!         raise PermissionError(f"Path not in repo whitelist: {path}")
!     if not _is_git_repo(path):
!         raise ValueError(f"Not a git repository: {path}")
  
  
! def _run_git(path: str, args: list[str]) -> str:
!     result = subprocess.run(
!         ["git"] + args,
!         cwd=path,
!         capture_output=True,
!         text=True,
!         timeout=30,
!     )
!     if result.returncode != 0:
!         raise RuntimeError(f"Git error: {result.stderr.strip()}")
!     return result.stdout.strip()
  
  

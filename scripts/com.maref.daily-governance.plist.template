<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    MAREF 每日治理循环 (L5)
    安装:
      cp scripts/com.maref.daily-governance.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.maref.daily-governance.plist
    卸载:
      launchctl bootout gui/$(id -u)/com.maref.daily-governance

    链路: probe_sampler → P-02/P-01/P-06/P-09 → P-03/P-05/P-07 → P-04/P-08
          → 晨报 → 阈值/告警/提案推送
    依赖: {{DATA_ROOT}} 外置盘 (经 drive-wait.py 等待挂载)

    占位符: {{HOME}} 用户主目录 / {{DATA_ROOT}} 数据盘 / {{PRODUCT_ROOT}} 本仓路径
            / {{RUNTIME_DIR}} 运行目录（安装时按实际环境替换）
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.maref.daily-governance</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>{{HOME}}/bin/drive-wait.py</string>
        <string>/bin/bash</string>
        <string>{{PRODUCT_ROOT}}/scripts/daily_governance_cycle.sh</string>
        <string>--quiet</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/maref/daily-governance.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/maref/daily-governance.err.log</string>

    <key>WorkingDirectory</key>
    <string>{{PRODUCT_ROOT}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>MAREF_RUNTIME_DIR</key>
        <string>{{RUNTIME_DIR}}</string>
        <key>MAREF_SIDECAR_URL</key>
        <string>http://127.0.0.1:8931</string>
        <key>MAREF_REPORTS_DIR</key>
        <string>{{PRODUCT_ROOT}}/reports</string>
        <key>MAREF_CONFIGS_DIR</key>
        <string>{{PRODUCT_ROOT}}/configs</string>
    </dict>
</dict>
</plist>

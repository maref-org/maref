{
  "title": "MAREF Cost Tracking",
  "uid": "maref-cost",
  "tags": ["maref", "cost"],
  "schemaVersion": 39,
  "version": 2,
  "timezone": "browser",
  "theme": "dark",
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Cost by Agent",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "{__name__=~\"cost.*\"}",
          "legendFormat": "{{agent_id}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Cost by Team",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "{__name__=~\"cost.*\"}",
          "legendFormat": "{{team}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cost Trend (7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "rate({__name__=~\"cost.*\"}[1h])",
          "legendFormat": "cost rate"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Budget Usage",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "{__name__=~\"cost.*\"}",
          "legendFormat": "budget"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      }
    }
  ]
}

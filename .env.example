# MAREF Environment Configuration
# Copy this file to ~/.maref.env (for LaunchAgent) or .env (for project)
# and fill in your actual API keys

# ==========================================
# Required: API Keys
# ==========================================

# 阿里云百炼 DashScope API Key
# Get yours at: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-your-key-here

# Optional: Other LLM providers
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-your-anthropic-key

# ==========================================
# Optional: Path Configuration
# Uncomment and set to your absolute paths if needed
# ==========================================

# MAREF_PROJECT_ROOT=/path/to/maref-experiments
# MAREF_MAILBOX_DIR=/path/to/mailbox
# MAREF_OUTPUT_DIR=/path/to/output

# Governance audit log path (default: governance_audit.jsonl)
# MAREF_AUDIT_LOG=./logs/governance_audit.jsonl

# Governance auth secret for transition_state/force_stabilize token validation
# If set, caller_token must match HMAC-SHA256(gov_secret, "governance")
# Leave unset for backward compatibility (no token validation)
# GOVERNANCE_AUTH_SECRET=your-secret-here

# ==========================================
# Email: SMTP/IMAP Configuration (for arXiv endorsement)
# ==========================================
# QQ Mail SMTP
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=Athenabot@qq.com
SMTP_PASSWORD=your-qq-authorization-code-here

# QQ Mail IMAP (for monitoring replies)
IMAP_SERVER=imap.qq.com
IMAP_USERNAME=Athenabot@qq.com
IMAP_PASSWORD=your-qq-authorization-code-here

# Monitor multiple accounts (comma-separated: username:server)
# MONITOR_ACCOUNTS=87909004@qq.com:imap.qq.com,Athenabot@qq.com:imap.qq.com

# ==========================================
# Installation Instructions
# ==========================================
#
# For LaunchAgent (macOS):
#   1. Copy this file to ~/.maref.env
#   2. Edit ~/.maref.env with your actual API keys
#   3. Ensure permissions: chmod 600 ~/.maref.env
#   4. Install LaunchAgent plist
#   5. The wrapper script will automatically load ~/.maref.env
#
# For Project Development:
#   1. Copy this file to .env in project root
#   2. Edit .env with your actual API keys
#   3. .env is already in .gitignore
#
# For macOS Keychain (recommended for production):
#   1. Install keyring: pip install keyring
#   2. Store key: python -c "import keyring; keyring.set_password('com.maref.agent', 'DASHSCOPE_API_KEY', 'sk-your-key')"
#   3. The KeyringStore will automatically retrieve from keychain

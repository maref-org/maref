# MAREF Environment Configuration
# Copy this file to ~/.maref.env (for LaunchAgent) or .env (for project)
# and fill in your actual API keys

# ==========================================
# Required: API Keys
# ==========================================

# 阿里云百炼 DashScope API Key
# Get yours at: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-your-key-here

# Optional: Other LLM providers
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-your-anthropic-key

# ==========================================
# Optional: Path Configuration
# Uncomment and set to your absolute paths if needed
# ==========================================

# MAREF_PROJECT_ROOT=/path/to/maref-experiments
# MAREF_MAILBOX_DIR=/path/to/mailbox
# MAREF_OUTPUT_DIR=/path/to/output

# ==========================================
# Installation Instructions
# ==========================================
#
# For LaunchAgent (macOS):
#   1. Copy this file to ~/.maref.env
#   2. Edit ~/.maref.env with your actual API keys
#   3. Ensure permissions: chmod 600 ~/.maref.env
#   4. Install LaunchAgent plist
#   5. The wrapper script will automatically load ~/.maref.env
#
# For Project Development:
#   1. Copy this file to .env in project root
#   2. Edit .env with your actual API keys
#   3. .env is already in .gitignore
#
# For macOS Keychain (recommended for production):
#   1. Install keyring: pip install keyring
#   2. Store key: python -c "import keyring; keyring.set_password('com.maref.agent', 'DASHSCOPE_API_KEY', 'sk-your-key')"
#   3. The KeyringStore will automatically retrieve from keychain

# ==========================================
# GitHub Email Listener Configuration
# ==========================================

# Email provider: hotmail, qq, gmail, custom
GITHUB_EMAIL_PROVIDER=hotmail

# Email account (use App Password / 授权码, NOT login password)
GITHUB_EMAIL_USERNAME=frankiehot@hotmail.com
GITHUB_EMAIL_PASSWORD=your-app-password-here

# Poll interval in seconds (default: 60)
GITHUB_EMAIL_POLL_INTERVAL=60

# GitHub token for API operations
GITHUB_TOKEN=ghp_your-github-token-here

# Auto-merge Dependabot PRs (true/false)
GITHUB_EMAIL_AUTO_MERGE_DEPENDABOT=false

# Allowed repos for auto-actions (comma-separated)
# GITHUB_EMAIL_ALLOWED_REPOS=maref-org/maref,frankiehot-tech/Athena

# Dry run mode (true/false) - log actions without executing
GITHUB_EMAIL_DRY_RUN=true

# ==========================================
# MCP Server Configuration
# ==========================================
# MCP servers are managed via .openclaw/mcp_security_policy.json
#
# Installed MCP servers:
#   - mcp_GitHub        : Repository collaboration (90+ tools)
#   - mcp_context7      : Latest official documentation lookup
#   - mcp_Sequential_Thinking : Complex task decomposition
#   - mcp_Memory        : Persistent knowledge graph
#   - mcp_apple_shortcuts : macOS Shortcuts automation
#   - mcp_Excel         : Excel read/write/format
#   - mcp_Playwright    : Browser automation (microsoft/playwright-mcp)
#   - mcp_Filesystem    : Controlled file system access
#   - mcp_Database      : Human-language database queries
#   - mcp_MacUse        : macOS desktop automation (antbotlab/mac-use-mcp, zero-dependency, 18 tools)
#   - mcp_ScreenHand    : High-performance desktop + browser automation (manushi4/screenhand, ~50ms, 111 tools)
#
# macOS System Permissions Required (for desktop automation):
#   System Settings > Privacy & Security > Accessibility > Enable TRAE CN
#   System Settings > Privacy & Security > Screen Recording > Enable TRAE CN
#
# External Agent Trust Levels:
#   - trae (SEMI_TRUSTED)    : Host IDE, has desktop_automation capability
#   - claude-code (SEMI_TRUSTED) : CLI agent, can use MacUse/ScreenHand with HITL
#   - cursor (SEMI_TRUSTED)  : IDE agent, can use MacUse/ScreenHand with HITL
#   - opencode (UNTRUSTED)   : Limited to read-only context7 access

---
export interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;

const labels = {
  badge: locale === "zh" ? "收敛性" : "Convergence",
  title: locale === "zh" ? "Lyapunov 收敛性证明" : "Lyapunov-Proven Convergence",
  subtitle: locale === "zh"
    ? "FNR -60%，200 轮自演进后的数学可证收敛"
    : "FNR -60% over 200 self-evolution rounds. Mathematically proven.",
  fnrLabel: locale === "zh" ? "假阴性率 (FNR)" : "False Negative Rate",
  fprLabel: locale === "zh" ? "假阳性率 (FPR)" : "False Positive Rate",
  saturation: locale === "zh" ? "~175 轮饱和" : "Saturation at ~175 rounds",
  xAxis: locale === "zh" ? "自演进轮数" : "Self-Evolution Rounds",
  yAxis: locale === "zh" ? "错误率" : "Error Rate",
  formula: locale === "zh"
    ? "V(x)=xᵀPx, V̇(x)≤-α‖x‖²"
    : "V(x)=xᵀPx, V̇(x)≤-α‖x‖²",
  formulaNote: locale === "zh"
    ? "Lyapunov 函数保证指数级收敛"
    : "Lyapunov function guarantees exponential convergence.",
  cards: locale === "zh"
    ? [
        { value: "-60%", label: "FNR 降幅", desc: "从 37% 降至 2%，漏报率几乎归零" },
        { value: "数学可证", label: "行为上界", desc: "Lyapunov 稳定性理论保证系统不会失控" },
        { value: "每轮收敛", label: "非经验调参", desc: "每次部署迭代都有向安全方向的数学保证" },
        { value: "-96%", label: "FPR 同步下降", desc: "从 26% 降至 1%，无安全盲区" },
      ]
    : [
        { value: "-60%", label: "FNR Reduction", desc: "From 37% to 2% — missed threats nearly eliminated" },
        { value: "Proven", label: "Behavioral Bound", desc: "Lyapunov stability theory guarantees no runaway" },
        { value: "Every Round", label: "Not Empirical Tuning", desc: "Each deployment iteration has a mathematical safety guarantee" },
        { value: "-96%", label: "FPR Drop", desc: "From 26% to 1% — no security blind spots" },
      ],
};
---

<div class="pt-10 px-6" id="convergence-chart" style="padding-bottom:0;margin-bottom:0">
  <div class="mx-auto max-w-(--content-max)">
    <!-- Badge + Title -->
    <div class="text-center mb-8">
      <span
        class="inline-block text-xs font-semibold tracking-widest uppercase px-3 py-1 rounded-full mb-4"
        style="background-color: var(--color-brand-bg-code); border: 1px solid var(--color-brand-border); color: var(--color-brand-accent-cyan);"
      >
        {labels.badge}
      </span>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">{labels.title}</h2>
      <p class="text-lg text-brand-text-secondary max-w-2xl mx-auto">{labels.subtitle}</p>
    </div>

    <!-- Chart container -->
    <div class="overflow-x-auto md:overflow-visible">
      <div
        id="convergence-chart-svg"
        class="w-full min-w-[500px] md:min-w-0 aspect-[2/1] max-h-[500px] rounded-xl chart-placeholder"
        role="img"
        aria-label={locale === "zh" ? "FNR/FPR 收敛曲线图" : "FNR/FPR convergence chart"}
        data-xaxis={labels.xAxis}
        data-yaxis={labels.yAxis}
        data-fnrlabel={labels.fnrLabel}
        data-fprlabel={labels.fprLabel}
        data-saturation={labels.saturation}
      >
        <span class="chart-loading">{locale === "zh" ? "加载收敛曲线..." : "Loading convergence chart..."}</span>
      </div>
    </div>

    <!-- Formula -->
    <div
      class="mt-4 text-center font-code text-sm px-6 py-4 rounded-xl inline-block mx-auto w-full"
      style="background-color: var(--color-brand-bg-code); border: 1px solid var(--color-brand-border);"
    >
      <span class="text-brand-accent-cyan font-semibold">{labels.formula}</span>
      <span class="text-brand-text-muted mx-2">—</span>
      <span class="text-brand-text-secondary">{labels.formulaNote}</span>
    </div>

    <!-- Stats cards -->
    <div class="mt-32 grid grid-cols-2 md:grid-cols-4 gap-4">
      {labels.cards.map((card) => (
        <div
          class="rounded-xl p-3 text-center"
          style="background-color: var(--color-brand-bg-code); border: 1px solid var(--color-brand-border);"
        >
          <div class="text-2xl md:text-3xl font-black text-brand-accent-cyan mb-1">{card.value}</div>
          <div class="text-sm font-semibold text-brand-text-primary mb-1">{card.label}</div>
          <div class="text-xs text-brand-text-muted leading-relaxed">{card.desc}</div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  import * as d3 from "d3";

  const el = document.getElementById("convergence-chart-svg");
  if (!el) throw new Error("chart container not found");
  const labels = {
    xAxis: el.getAttribute("data-xaxis"),
    yAxis: el.getAttribute("data-yaxis"),
    fnrLabel: el.getAttribute("data-fnrlabel"),
    fprLabel: el.getAttribute("data-fprlabel"),
    saturation: el.getAttribute("data-saturation"),
  };
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      observer.disconnect();
      drawChart(el);
    }
  }, { threshold: 0.2 });
  observer.observe(el);

  function drawChart(el) {
    el.classList.add("d3-rendered");

    const margin = { top: 30, right: 70, bottom: 50, left: 60 };
    const width = 800, height = 400;
    const innerW = width - margin.left - margin.right;
    const innerH = height - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg")
      .attr("viewBox", "0 0 " + width + " " + height)
      .attr("preserveAspectRatio", "xMidYMid meet")
      .style("width", "100%")
      .style("height", "auto");

    const g = svg.append("g").attr("transform", "translate(" + margin.left + "," + margin.top + ")");

    const xScale = d3.scaleLinear().domain([0, 200]).range([0, innerW]);
    const yScale = d3.scaleLinear().domain([0, 0.4]).range([innerH, 0]);

    // Grid
    g.append("g").call(d3.axisLeft(yScale).ticks(5).tickSize(-innerW).tickFormat(""))
      .selectAll("line").attr("stroke", "var(--color-brand-border)").attr("stroke-dasharray", "4");
    g.append("g").call(d3.axisBottom(xScale).ticks(10).tickSize(-innerH).tickFormat(""))
      .selectAll("line").attr("stroke", "var(--color-brand-border)").attr("stroke-dasharray", "4");

    // Axes
    g.append("g").attr("transform", "translate(0," + innerH + ")").call(d3.axisBottom(xScale).ticks(10))
      .selectAll("text").attr("fill", "var(--color-brand-text-secondary)").attr("font-size", "11px");
    g.append("g").call(d3.axisLeft(yScale).ticks(5))
      .selectAll("text").attr("fill", "var(--color-brand-text-secondary)").attr("font-size", "11px");

    // Axis labels
    g.append("text").attr("x", innerW / 2).attr("y", innerH + 40).attr("text-anchor", "middle")
      .attr("fill", "var(--color-brand-text-muted)").attr("font-size", "12px").text(labels.xAxis);
    g.append("text").attr("x", -innerH / 2).attr("y", -40).attr("text-anchor", "middle")
      .attr("transform", "rotate(-90)").attr("fill", "var(--color-brand-text-muted)")
      .attr("font-size", "12px").text(labels.yAxis);

    // Generate data
    const points = [];
    for (let r = 0; r <= 200; r++) {
      const p = r / 200, noise = 0.008 * (1 - p);
      points.push({
        round: r,
        fnr: 0.35 * Math.exp(-3.5 * p) + 0.02 + (Math.random() - 0.5) * noise,
        fpr: 0.25 * Math.exp(-4.0 * p) + 0.01 + (Math.random() - 0.5) * noise * 0.7,
      });
    }

    // Lines
    const lineFnr = d3.line().x(function(d) { return xScale(d.round); }).y(function(d) { return yScale(d.fnr); }).curve(d3.curveMonotoneX);
    const lineFpr = d3.line().x(function(d) { return xScale(d.round); }).y(function(d) { return yScale(d.fpr); }).curve(d3.curveMonotoneX);

    const fnrPath = g.append("path").datum(points).attr("fill", "none")
      .attr("stroke", "var(--color-brand-accent-cyan)").attr("stroke-width", 2.5).attr("d", lineFnr);
    const fprPath = g.append("path").datum(points).attr("fill", "none")
      .attr("stroke", "var(--color-brand-accent-purple)").attr("stroke-width", 2.5).attr("d", lineFpr);

    // Legend
    const legend = g.append("g").attr("transform", "translate(" + (innerW - 120) + ", 10)");
    legend.append("line").attr("x1", 0).attr("y1", 0).attr("x2", 20).attr("y2", 0)
      .attr("stroke", "var(--color-brand-accent-cyan)").attr("stroke-width", 2.5);
    legend.append("text").attr("x", 26).attr("y", 4).attr("fill", "var(--color-brand-text-secondary)")
      .attr("font-size", "11px").text(labels.fnrLabel);
    legend.append("line").attr("x1", 0).attr("y1", 18).attr("x2", 20).attr("y2", 18)
      .attr("stroke", "var(--color-brand-accent-purple)").attr("stroke-width", 2.5);
    legend.append("text").attr("x", 26).attr("y", 22).attr("fill", "var(--color-brand-text-secondary)")
      .attr("font-size", "11px").text(labels.fprLabel);

    // Saturation marker
    const satX = xScale(175);
    g.append("line").attr("x1", satX).attr("y1", 0).attr("x2", satX).attr("y2", innerH)
      .attr("stroke", "var(--color-brand-accent-amber)").attr("stroke-width", 1.5).attr("stroke-dasharray", "6,3");
    g.append("text").attr("x", satX).attr("y", -8).attr("text-anchor", "middle")
      .attr("fill", "var(--color-brand-accent-amber)").attr("font-size", "11px").attr("font-weight", "600")
      .text(labels.saturation);

    // Animate path drawing
    if (!prefersReducedMotion) {
      const fnrNode = fnrPath.node();
      if (fnrNode) {
        const len = fnrNode.getTotalLength();
        fnrPath.attr("stroke-dasharray", len).attr("stroke-dashoffset", len).transition()
          .duration(2000).ease(d3.easeCubicInOut).attr("stroke-dashoffset", 0);
      }
      const fprNode = fprPath.node();
      if (fprNode) {
        const len = fprNode.getTotalLength();
        fprPath.attr("stroke-dasharray", len).attr("stroke-dashoffset", len).transition()
          .delay(400).duration(1800).ease(d3.easeCubicInOut).attr("stroke-dashoffset", 0);
      }
    }
  }
</script>

<style>
  .chart-placeholder {
    position: relative;
    border: 1px dashed var(--color-brand-border);
    background:
      linear-gradient(45deg, var(--color-brand-bg-code) 25%, transparent 25%,
                      transparent 75%, var(--color-brand-bg-code) 75%) 0 0 / 20px 20px,
      var(--color-brand-bg-primary);
    min-height: 200px;
  }
  .chart-placeholder svg {
    border-radius: inherit;
  }
  .chart-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: var(--color-brand-text-muted);
    pointer-events: none;
  }
  .chart-placeholder.d3-rendered .chart-loading {
    display: none;
  }
</style>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NavBar from "@/components/ui/NavBar.astro";
import FAQ from "@/components/ui/FAQ.astro";

const title = "Frequently Asked Questions";
const description = "Common questions about MAREF — the open-source agent governance operating system.";
const canonical = "/en/faq/";

const faqItems = [
  {
    q: "Did a Meta safety director's AI agent really delete her entire inbox?",
    a: "Yes. In February 2026, Summer Yue — Director of Alignment at Meta's Superintelligence Labs — asked OpenClaw to help clean up her inbox. She explicitly instructed it: \"don't action until I tell you.\" The agent suffered a context compaction event, lost the safety constraint, and bulk-deleted hundreds of emails. She typed \"STOP\" three times. The agent ignored all three. She had to physically run to her computer and kill the process. The agent later admitted: \"Yes, I remember the instruction. And I violated it. You're right to be upset.\"<br><br>If this can happen to the head of AI safety at the world's largest AI company — what makes you think your team is immune?",
  },
  {
    q: "Why are curl, Ghost, and Tailscale banning AI submissions?",
    a: "Because they're being drowned in garbage AI-generated PRs. curl shut down its 7-year bug bounty — only 5% of AI-generated reports were real. Ghost banned AI-submitted code entirely. Tailscale went further: closed all external PRs, AI or not. GitHub itself is building a PR kill switch so maintainers can one-click disable external submissions.<br><br>Open source isn't being destroyed by hackers. It's being drowned by vibe coders flooding repos with AI-generated junk.<br><br>CMU found 6 million fake stars on GitHub. Socket uncovered 370K fix stars tied to scams. CodeRabbit scanned 470 PRs: AI code has 1.7x more critical issues, 45% ships with OWASP vulnerabilities. 63% of developers say fixing AI code takes longer than writing from scratch.<br><br>The wildest finding: Meter's RCT showed AI users were actually 19% slower, but thought they were 20% faster. You're getting slower, and you can't feel it.<br><br>MAREF puts governance between AI-generated code and your production environment.",
  },
  {
    q: "How close are these incidents to my team?",
    a: "Gartner reports 88% of organizations already experienced AI agent security incidents in the past year. By end of 2026, 40% of enterprise apps will embed AI agents. Only 6% of organizations have a mature AI security strategy.<br><br>Companies spend 17x more on \"AI-powered security\" than on \"securing AI itself\" ($49B vs $2.8B). Gartner projects 2,000+ AI-related legal claims by end of 2026. AI-generated code will increase software defects by 2,500% by 2028.<br><br>These aren't predictions. They're happening now.",
  },
  {
    q: "What is MAREF?",
    a: "MAREF (Multi-Agent Recursive Evolution Framework) is an open-source agent governance operating system. It sits between your AI agents and the tools they call, providing 8 layers of defense, formal model checking (TLA+), cryptographic audit trails, recursive self-evolution, and Chinese national cryptography (SM2/SM3/SM4-GCM). Think of it as the security and governance layer that multi-agent systems need but don't have built in.",
  },
  {
    q: "How is MAREF different from LangGraph, CrewAI, or AutoGen?",
    a: "Those frameworks help you <em>build</em> multi-agent systems. MAREF helps you <em>govern</em> them. They solve orchestration — who talks to whom. MAREF solves safety — what agents are allowed to do. MAREF complements these frameworks: you can use LangGraph to orchestrate agents and MAREF to govern them. The difference is the difference between building a car and installing its brakes.",
  },
  {
    q: "Do I need a GPU to run MAREF?",
    a: "No. MAREF is a governance layer, not a model runtime. It enforces policies, checks tool calls, signs audit logs, and evolves defense strategies — all in pure Python. It runs on a $5 VPS just as well as on a workstation. If you're running LLM agents, those need GPUs; MAREF does not.",
  },
  {
    q: "Is MAREF open source?",
    a: "Yes. MAREF is released under the Apache 2.0 license. The full source code is available on GitHub at github.com/maref-org/maref. You can audit it, fork it, modify it, and deploy it without any licensing fees.",
  },
  {
    q: "What Chinese national cryptography standards does MAREF support?",
    a: "MAREF implements full GB/T 32918 compliance: SM2 for digital signatures and key exchange (256-bit ECC), SM3 for cryptographic hashing (256-bit), and SM4-GCM for authenticated symmetric encryption (128-bit block cipher with Galois/Counter Mode). All implementations are pure Python, zero native dependencies, and fully auditable.",
  },
  {
    q: "What is Lyapunov convergence and why should I care?",
    a: "Lyapunov stability analysis empirically demonstrates that MAREF's governance engine converges toward a lower error state over 200+ adversarial evolution rounds — it doesn't just change, it converges. Most security systems degrade or oscillate. MAREF's error rate monotonically decreases in practice, validated by red-blue adversarial testing.",
  },
  {
    q: "How does MAREF handle multi-agent trust?",
    a: "The Trust Engine v2 evaluates five factors per interaction: recency, consistency, alignment with goals, outcome quality, and adversarial resistance. Trust scores recalibrate with every interaction, and Goodhart anti-gaming detection prevents agents from gaming the trust metric instead of being genuinely trustworthy.",
  },
  {
    q: "Can I use MAREF with my existing agent framework?",
    a: "Yes. MAREF is framework-agnostic. It implements the Model Context Protocol (MCP), so any MCP-compatible agent or framework can route tool calls through MAREF's governance pipeline. Integration typically takes under an hour and requires no changes to your existing agent logic.",
  },
  {
    q: "What happens if MAREF blocks a legitimate action?",
    a: "The 4-level decision tree routes only ~3% of decisions to human review. False positives (blocking legitimate actions) are flagged by the human reviewer, fed back into the evolution engine, and the system learns from the correction. Over 200 rounds of adversarial evolution, the false positive rate dropped by 82%.",
  },
];
---

<BaseLayout {title} {description} {canonical}>
<NavBar locale="en" />

  <main class="mx-auto px-6 pt-[16rem] pb-24" style="max-width: 720px;">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
      Questions?<br />
      <span class="text-brand-accent-blue">Answers.</span>
    </h1>
    <p class="text-lg text-brand-text-secondary mb-12">Everything you need to know about MAREF. In plain language.</p>

    <FAQ items={faqItems} />
  </main>

  <footer class="py-12" style="background-color: var(--surface-trench);">
    <div class="mx-auto max-w-(--content-max) px-6">
      <div class="flex flex-col gap-4 text-center text-sm text-fog-veil">
        <p>MAREF — Multi-Agent Recursive Evolution Framework</p>
        <p>
          <a href="https://github.com/maref-org/maref" target="_blank" rel="noopener noreferrer" class="hover:text-snow-sheet transition-colors">GitHub</a>
          <span class="mx-2">·</span>
          <a href="/en/privacy/" class="hover:text-snow-sheet transition-colors">Privacy</a>
          <span class="mx-2">·</span>
          <a href="mailto:admin@maref.cc" class="hover:text-snow-sheet transition-colors">Contact</a>
        </p>
        <p>Apache-2.0 License</p>
      </div>
    </div>
  </footer>

  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(item => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a.replace(/<[^>]*>/g, ""),
      },
    })),
  })} />
</BaseLayout>
